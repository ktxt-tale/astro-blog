---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<li class="inline-flex">
  <a
    href={`${base}tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-flex items-center rounded-full border border-skin-line bg-skin-card/35 font-medium transition hover:border-skin-accent hover:text-skin-accent focus-visible:no-underline",
      size === "sm" ? "px-3 py-1.5 text-xs" : "px-4 py-2 text-sm sm:text-base",
    ]}
  >
    <span class="mr-1 opacity-45">#</span>{tag}
  </a>
</li>
