---
import { SITE } from "@config";

export interface Props {
  activeNav?: "projects" | "posts" | "tags" | "about" | "search";
}

const { activeNav } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="border-b border-skin-line/80">
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-5 sm:py-6">
    <a href={base} class="flex items-center gap-3 font-semibold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-xl bg-skin-inverted text-sm text-skin-inverted">K</span>
      <span>{SITE.title}</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Main navigation">
      <a href={`${base}projects/`} class:list={["nav-link", { active: activeNav === "projects" }]}>Projects</a>
      <a href={`${base}posts/`} class:list={["nav-link", { active: activeNav === "posts" }]}>Writing</a>
      <a href={`${base}about/`} class:list={["nav-link", { active: activeNav === "about" }]}>About</a>
      <a href={`${base}search/`} class:list={["nav-link hidden sm:inline-flex", { active: activeNav === "search" }]}>Search</a>
      {SITE.lightAndDarkMode && (
        <button id="theme-btn" class="ml-1 rounded-xl p-2.5 hover:bg-skin-card" title="Toggle theme" aria-label="auto" aria-live="polite">
          <svg xmlns="http://www.w3.org/2000/svg" id="moon-svg" viewBox="0 0 24 24"><path d="M20.742 13.045a8.088 8.088 0 0 1-2.077.271c-4.422 0-8-3.578-8-8 0-.703.09-1.385.26-2.034A10 10 0 1 0 20.742 13.045z" /></svg>
          <svg xmlns="http://www.w3.org/2000/svg" id="sun-svg" viewBox="0 0 24 24"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5h1v3h-2V2h1zm0 17h1v3h-2v-3h1zM2 11h3v2H2v-2zm17 0h3v2h-3v-2zM4.22 5.64l1.42-1.42 2.12 2.12-1.42 1.42-2.12-2.12zm12.02 12.02 1.42-1.42 2.12 2.12-1.42 1.42-2.12-2.12zM4.22 18.36l2.12-2.12 1.42 1.42-2.12 2.12-1.42-1.42zM16.24 6.34l2.12-2.12 1.42 1.42-2.12 2.12-1.42-1.42z" /></svg>
        </button>
      )}
    </nav>
  </div>
</header>

<style>
  #skip-to-content {
    @apply absolute -top-full left-4 z-50 rounded-lg bg-skin-accent px-3 py-2 text-sm text-skin-inverted transition-all focus:top-4;
  }
  .nav-link {
    @apply inline-flex rounded-xl px-3 py-2 text-sm font-medium opacity-65 transition hover:bg-skin-card hover:opacity-100;
  }
  .nav-link.active {
    @apply bg-skin-card opacity-100;
  }
  #theme-btn svg {
    @apply h-5 w-5;
  }
</style>
