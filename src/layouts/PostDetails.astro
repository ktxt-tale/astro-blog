---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import { SITE } from "@config";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;
const { Content } = await post.render();

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const fallbackOgImage = `posts/${slugifyStr(title)}.png`;
const relativeOgImage = (ogImageUrl ?? fallbackOgImage).replace(/^\/+/, "");
const ogUrl = /^https?:\/\//.test(ogImageUrl ?? "")
  ? ogImageUrl
  : new URL(`${base}${relativeOgImage}`, Astro.url.origin).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header activeNav="posts" />
  <main id="main-content">
    <a class="back-link" href={`${base}posts/`}>← Writing</a>

    <header class="article-header">
      <div class="article-kicker">Field note</div>
      <h1 transition:name={slugifyStr(title)}>{title}</h1>
      <p class="dek">{description}</p>
      <div class="meta-row">
        <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} size="lg" />
        <span class="dot" aria-hidden="true">•</span>
        <span>{author}</span>
      </div>
      {tags.length > 0 && (
        <ul class="tag-list">
          {tags.map(tag => <Tag tag={slugifyStr(tag)} />)}
        </ul>
      )}
    </header>

    <article id="article" role="article" class="prose">
      <Content />
    </article>

    <footer class="article-footer">
      <div>
        <p class="footer-label">Share this note</p>
        <ShareLinks />
      </div>
      <button id="back-to-top" class="back-top">Back to top ↑</button>
    </footer>
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }
  .back-link {
    @apply mt-8 inline-flex rounded-lg px-2 py-1 text-sm font-medium opacity-60 transition hover:bg-skin-card hover:opacity-100 sm:mt-12;
  }
  .article-header {
    @apply mx-auto max-w-3xl border-b border-skin-line pb-10 pt-8 sm:pb-12 sm:pt-12;
  }
  .article-kicker,
  .footer-label {
    @apply text-xs font-semibold uppercase tracking-[0.22em] text-skin-accent;
  }
  .article-header h1 {
    @apply mt-4 text-4xl font-semibold leading-tight tracking-tight sm:text-6xl;
  }
  .dek {
    @apply mt-5 max-w-2xl text-lg leading-8 opacity-65;
  }
  .meta-row {
    @apply mt-6 flex flex-wrap items-center gap-3 text-sm opacity-55;
  }
  .dot {
    @apply opacity-40;
  }
  .tag-list {
    @apply mt-5 flex flex-wrap gap-2;
  }
  #article {
    @apply mx-auto mt-12 max-w-3xl sm:mt-16;
  }
  .article-footer {
    @apply mx-auto mt-16 flex max-w-3xl flex-col gap-8 border-t border-skin-line pt-8 sm:flex-row sm:items-end sm:justify-between;
  }
  .back-top {
    @apply rounded-xl border border-skin-line px-4 py-2 text-sm font-medium transition hover:bg-skin-card;
  }
</style>

<script is:inline>
  function ensureProgressBar() {
    if (document.getElementById("reading-progress")) return;
    const track = document.createElement("div");
    track.className = "fixed left-0 top-0 z-50 h-[2px] w-full bg-transparent";
    const bar = document.createElement("div");
    bar.id = "reading-progress";
    bar.className = "h-full w-0 bg-skin-accent";
    track.appendChild(bar);
    document.body.appendChild(track);
  }

  function updateProgress() {
    const max = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
    const bar = document.getElementById("reading-progress");
    if (bar) bar.style.width = `${pct}%`;
  }

  function addHeadingLinks() {
    document.querySelectorAll("#article h2, #article h3, #article h4").forEach(heading => {
      if (!heading.id || heading.querySelector(".heading-link")) return;
      heading.classList.add("group");
      const link = document.createElement("a");
      link.textContent = "#";
      link.className = "heading-link ml-2 opacity-0 transition group-hover:opacity-50";
      link.href = `#${heading.id}`;
      link.setAttribute("aria-label", `Link to ${heading.textContent}`);
      heading.appendChild(link);
    });
  }

  function attachCopyButtons() {
    document.querySelectorAll("#article pre").forEach(codeBlock => {
      if (codeBlock.querySelector(".copy-code")) return;
      codeBlock.style.position = "relative";
      const button = document.createElement("button");
      button.className = "copy-code absolute right-3 top-3 rounded-lg bg-skin-card px-2.5 py-1.5 text-xs font-medium text-skin-base";
      button.textContent = "Copy";
      button.addEventListener("click", async () => {
        const code = codeBlock.querySelector("code")?.textContent ?? "";
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy"), 900);
      });
      codeBlock.appendChild(button);
    });
  }

  function initArticle() {
    ensureProgressBar();
    updateProgress();
    addHeadingLinks();
    attachCopyButtons();
    document.getElementById("back-to-top")?.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" })
    );
  }

  initArticle();
  document.addEventListener("scroll", updateProgress, { passive: true });
  document.addEventListener("astro:after-swap", initArticle);
</script>
