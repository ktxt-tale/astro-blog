---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

const base = import.meta.env.BASE_URL;
const projects = (await getCollection("projects"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year);
---

<Layout title="Projects">
  <Header activeNav="projects" />
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 pb-24 pt-14 sm:pt-20">
    <div class="mb-12 max-w-2xl">
      <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-skin-accent">Selected work</p>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">Products, tools, and experiments.</h1>
      <p class="mt-5 text-lg leading-8 opacity-70">A collection of things I have designed, built, shipped, or am actively exploring.</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {projects.map(({ slug, data }) => (
        <a href={`${base}projects/${slug}/`} class="group overflow-hidden rounded-3xl border border-skin-line bg-skin-card/30 transition hover:-translate-y-1 hover:border-skin-accent">
          {data.cover && (
            <div class="aspect-[1.9/1] overflow-hidden border-b border-skin-line bg-skin-card">
              <img src={data.cover} alt={`Cover for ${data.title}`} class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.015]" loading="lazy" />
            </div>
          )}
          <div class="p-6 sm:p-8">
            <div class="mb-10 flex items-center justify-between text-xs uppercase tracking-[0.14em] opacity-60">
              <span>{data.year}</span>
              <span>{data.status}</span>
            </div>
            <h2 class="text-2xl font-semibold tracking-tight group-hover:text-skin-accent">{data.title}</h2>
            <p class="mt-3 leading-7 opacity-70">{data.summary}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {data.stack.slice(0, 4).map(item => <span class="rounded-full border border-skin-line px-3 py-1 text-xs opacity-70">{item}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
