---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title={`404 | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="mx-auto flex w-full max-w-6xl flex-1 items-center px-4 py-20">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-skin-accent">404 / Lost route</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-tight sm:text-7xl">This page didn’t ship.</h1>
      <p class="mt-5 max-w-xl text-lg leading-8 opacity-60">The link may be outdated, moved, or still sitting in the backlog.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={base} class="rounded-xl bg-skin-inverted px-4 py-2.5 text-sm font-medium text-skin-inverted">Back home</a>
        <a href={`${base}projects/`} class="rounded-xl border border-skin-line px-4 py-2.5 text-sm font-medium hover:bg-skin-card">Browse projects</a>
        <a href={`${base}posts/`} class="rounded-xl border border-skin-line px-4 py-2.5 text-sm font-medium hover:bg-skin-card">Read writing</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
